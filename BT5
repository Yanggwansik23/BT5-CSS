<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>3 thẻ div lồng nhau</title>
  <style>
    .div-1 {
      background-color: #ffcccc;
      padding: 30px;
      border: 2px solid #ff0000;
    }
    .div-2 {
      background-color: #ccffcc;
      padding: 30px;
      border: 2px solid #00aa00;
    }
    .div-3 {
      background-color: #ccccff;
      padding: 30px;
      border: 2px solid #0000ff;
    }
  </style>
</head>
<body>

  <div class="div-1">
    Thẻ div ngoài cùng (Div 1)
    <div class="div-2">
      Thẻ div ở giữa (Div 2)
      <div class="div-3">
        Thẻ div trong cùng (Div 3)
      </div>
    </div>
  </div>

</body>
</html>
